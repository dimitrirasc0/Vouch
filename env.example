# Copy to .env and fill in. .env is git-ignored.

# Sandbox REST app (Developer Dashboard > Apps & Credentials > Sandbox, type Merchant,
# linked to the sandbox BUSINESS account; enable "Customer disputes" and "Transaction search").
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Webhook id from `npm run pp:webhook` (used to verify webhook signatures).
PAYPAL_WEBHOOK_ID=

# Sandbox PERSONAL (buyer) account email. Used to build the PayPal-Auth-Assertion header
# if the app has the disputes/create scope.
PAYPAL_BUYER_EMAIL=

# Hosted Postgres (Neon or Render), used for local dev and production.
DATABASE_URL=

# Random string used to HMAC-sign mandates: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MANDATE_SIGNING_SECRET=

# PayPal JS SDK in the browser (same value as PAYPAL_CLIENT_ID; client ids are public).
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Claude: the mandate parser, shopping agent, dispute agent and the AG Studio dashboard assistant.
ANTHROPIC_API_KEY=

# Optional: AG Studio licence key for /dashboard.
AG_STUDIO=


# Shared key for the remote MCP server at /api/mcp. Agents send it as `Authorization: Bearer <key>`
# (or `?key=<key>`). Generate: node -e "console.log('vouch_mcp_' + require('crypto').randomBytes(18).toString('hex'))"
MCP_API_KEY=
